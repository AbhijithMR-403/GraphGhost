# Copy to .env and fill in your values. .env is ignored by Git; never commit it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphghost
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# OpenAI: used to transcribe downloaded Reels and extract food-discovery details.
OPENAI_API_KEY=your_openai_api_key
# Optional model overrides (defaults shown).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-6-luna
